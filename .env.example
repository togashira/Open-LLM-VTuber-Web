# 開発環境用設定
NODE_ENV=development
HTTPS=true
PORT=3000

# バックエンド接続設定
VITE_BACKEND_PORT=12393
VITE_BACKEND_HOST=127.0.0.1

# 本番環境用設定（itcometrue.academy での実績）
# NODE_ENV=production
# HTTPS=true
# PORT=443
# VITE_BACKEND_HOST=itcometrue.academy
# VITE_WS_URL=wss://itcometrue.academy/client-ws
# VITE_BASE_URL=http://itcometrue.academy

# カスタムURL設定（完全指定で上書き）
# VITE_WS_URL=wss://your-domain.com/client-ws
# VITE_BASE_URL=http://your-domain.com

# その他の本番環境例
# VITE_BACKEND_HOST=yourdomain.com
# VITE_BACKEND_PORT=12393
# VITE_WS_URL=wss://yourdomain.com:12393/client-ws
# VITE_BASE_URL=https://yourdomain.com:12393
